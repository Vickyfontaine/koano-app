# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# isolated build dirs used by the pre-push gate / out-of-band verification builds
/.next-prepush
/.next-verify

# generated sample/review documents — regenerable, never committed
/live-tax-appeal-*.pdf
/screening-memo-*.pdf
/comparison-brief-*.pdf

# generated demo documents (regenerable via scripts/gen-community-docs.ts)
koano-*.pdf
koano-*.docx
