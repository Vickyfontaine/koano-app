diff --git a/src/components/dashboard/shell/shell.css b/src/components/dashboard/shell/shell.css
new file mode 100644
index 0000000..7db89a4
--- /dev/null
+++ b/src/components/dashboard/shell/shell.css
@@ -0,0 +1,748 @@
+/* App shell (UI sprint WS3). One grid, three navigation forms by width:
+   the full sidebar at 1280 and up, a 64px icon rail from 768 to 1279, a top
+   bar plus bottom tab bar below 768. One content width (--content-max). */
+
+.koano-shell {
+  display: grid;
+  grid-template-columns: 240px minmax(0, 1fr);
+  grid-template-rows: var(--nav-h) minmax(0, 1fr);
+  min-height: 100vh;
+  background: var(--white);
+}
+.shell-topbar {
+  grid-column: 1 / -1;
+  position: sticky;
+  top: 0;
+  z-index: 30;
+  height: var(--nav-h);
+  display: flex;
+  align-items: center;
+  gap: var(--space-4);
+  padding: 0 var(--space-5);
+  background: var(--white);
+  border-bottom: 1px solid var(--border-light);
+}
+.shell-topbar-logo {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  text-decoration: none;
+  border-radius: var(--radius-chip);
+}
+.shell-topbar-logo img {
+  height: 40px;
+  width: auto;
+  display: block;
+}
+.shell-topbar-search {
+  flex: 1 1 auto;
+  min-width: 0;
+  display: flex;
+  justify-content: center;
+}
+.shell-topbar-right {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  margin-left: auto;
+}
+.shell-plan-tag {
+  font-family: var(--font-mono);
+  font-size: var(--text-micro);
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--ink-muted);
+  background: var(--pale-wash);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-pill);
+  padding: 6px 10px;
+  white-space: nowrap;
+}
+.shell-lens-btn {
+  display: none;
+  align-items: center;
+  gap: 6px;
+  min-height: 44px;
+  padding: 0 var(--space-3);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-pill);
+  background: var(--white);
+  color: var(--ink-primary);
+  font: inherit;
+  font-size: var(--text-body);
+  font-weight: 500;
+  cursor: pointer;
+}
+
+/* Sidebar / rail ------------------------------------------------------- */
+.shell-side {
+  grid-row: 2;
+  position: sticky;
+  top: var(--nav-h);
+  height: calc(100vh - var(--nav-h));
+  overflow-y: auto;
+  background: var(--pale-wash);
+  border-right: 1px solid var(--border);
+  display: flex;
+  flex-direction: column;
+  padding: var(--space-4) var(--space-3);
+  gap: var(--space-2);
+}
+.shell-side-heading {
+  font-family: var(--font-mono);
+  font-size: var(--text-micro);
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--ink-muted);
+  padding: var(--space-2) var(--space-3) var(--space-1);
+}
+.shell-item {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  width: 100%;
+  min-height: 40px;
+  padding: 0 var(--space-3);
+  border: 0;
+  border-radius: var(--radius-chip);
+  background: transparent;
+  color: var(--ink-muted);
+  font: inherit;
+  font-size: var(--text-body);
+  text-align: left;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
+}
+.shell-item:hover {
+  color: var(--ink-primary);
+  background: rgba(255, 255, 255, 0.6);
+}
+.shell-item[aria-current="true"],
+.shell-item[aria-current="page"] {
+  color: var(--ink-primary);
+  background: var(--white);
+  font-weight: 500;
+  box-shadow: var(--shadow-flat);
+}
+.shell-item svg {
+  flex: none;
+  color: var(--ink-muted);
+}
+.shell-item[aria-current="true"] svg,
+.shell-item[aria-current="page"] svg {
+  color: var(--deep-navy);
+}
+.shell-item-label {
+  flex: 1 1 auto;
+  min-width: 0;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.shell-item-note {
+  font-family: var(--font-mono);
+  font-size: var(--text-micro);
+  letter-spacing: 0.06em;
+  color: var(--ink-muted);
+}
+.shell-side-sections .shell-item {
+  min-height: 36px;
+  font-size: var(--text-body);
+}
+.shell-side-spacer {
+  flex: 1 1 auto;
+}
+.shell-side-divider {
+  height: 1px;
+  background: var(--border);
+  margin: var(--space-2) var(--space-3);
+}
+
+/* Main --------------------------------------------------------------- */
+.shell-main {
+  grid-row: 2;
+  min-width: 0;
+  padding: var(--space-6) var(--space-6) var(--space-8);
+}
+.shell-content {
+  max-width: var(--content-max);
+  margin: 0 auto;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-5);
+}
+
+/* Bottom tabs (phones) ------------------------------------------------ */
+.shell-tabs {
+  display: none;
+  position: fixed;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  z-index: 30;
+  background: var(--white);
+  border-top: 1px solid var(--border);
+  padding: 6px var(--space-2) calc(6px + env(safe-area-inset-bottom, 0px));
+}
+.shell-tab {
+  flex: 1 1 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 2px;
+  min-height: 48px;
+  border: 0;
+  border-radius: var(--radius-chip);
+  background: transparent;
+  color: var(--ink-muted);
+  font: inherit;
+  font-size: var(--text-micro);
+  letter-spacing: 0.02em;
+  cursor: pointer;
+}
+.shell-tab[aria-current="true"] {
+  color: var(--deep-navy);
+}
+.shell-tab svg {
+  width: 22px;
+  height: 22px;
+}
+
+/* Sheets (phone lens picker, watchlist) ------------------------------- */
+.shell-sheet-backdrop {
+  position: fixed;
+  inset: 0;
+  z-index: 40;
+  background: rgba(13, 43, 62, 0.4);
+}
+.shell-sheet {
+  position: fixed;
+  z-index: 41;
+  background: var(--white);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  padding: var(--space-5);
+  overflow-y: auto;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  max-height: 86vh;
+  border-radius: var(--radius-deep) var(--radius-deep) 0 0;
+  box-shadow: var(--shadow-hover);
+  padding-bottom: calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
+}
+.shell-sheet-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+}
+.shell-sheet-title {
+  font-size: var(--text-h3);
+  font-weight: 500;
+  color: var(--ink-primary);
+  margin: 0;
+}
+.shell-sheet-close {
+  width: 44px;
+  height: 44px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid var(--border);
+  border-radius: 50%;
+  background: var(--white);
+  color: var(--ink-primary);
+  cursor: pointer;
+}
+@media (min-width: 768px) {
+  .shell-sheet {
+    left: auto;
+    top: var(--nav-h);
+    bottom: auto;
+    right: var(--space-5);
+    width: 420px;
+    max-height: calc(100vh - var(--nav-h) - var(--space-5));
+    border-radius: var(--radius-card);
+    margin-top: var(--space-2);
+  }
+}
+
+/* Responsive ----------------------------------------------------------- */
+@media (max-width: 1279px) {
+  .koano-shell {
+    grid-template-columns: 64px minmax(0, 1fr);
+  }
+  .shell-side {
+    padding: var(--space-3) var(--space-2);
+    align-items: center;
+  }
+  /* Rail mode applies to the sidebar only; the sheets keep their labels. */
+  .shell-side .shell-side-heading,
+  .shell-side .shell-item-label,
+  .shell-side .shell-item-note,
+  .shell-side .shell-side-sections {
+    display: none;
+  }
+  .shell-side .shell-item {
+    width: 44px;
+    height: 44px;
+    min-height: 44px;
+    padding: 0;
+    justify-content: center;
+  }
+  .shell-side-divider {
+    width: 32px;
+    margin: var(--space-2) 0;
+  }
+  .shell-main {
+    padding: var(--space-5) var(--space-5) var(--space-8);
+  }
+}
+@media (max-width: 767px) {
+  .koano-shell {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .shell-side {
+    display: none;
+  }
+  .shell-topbar {
+    padding: 0 var(--space-4);
+    gap: var(--space-3);
+  }
+  .shell-topbar-search {
+    display: none;
+  }
+  .shell-lens-btn {
+    display: inline-flex;
+  }
+  .shell-plan-tag {
+    display: none;
+  }
+  .shell-main {
+    padding: var(--space-4) var(--space-4) calc(var(--space-8) + 64px);
+  }
+  .shell-tabs {
+    display: flex;
+  }
+}
+
+/* Verdict band ---------------------------------------------------------- */
+.verdict-band {
+  background: var(--white);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-card);
+  padding: var(--space-5);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  max-height: 40vh;
+  overflow: auto;
+}
+.verdict-band-idle,
+.verdict-band-resolving {
+  background: var(--pale-wash);
+}
+.band-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  gap: var(--space-5);
+  flex-wrap: wrap;
+}
+.band-eyebrow {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  font-family: var(--font-mono);
+  font-size: var(--text-micro);
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--ink-muted);
+  margin-bottom: var(--space-2);
+}
+.band-title {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  font-size: var(--text-h3);
+  font-weight: 500;
+  color: var(--ink-primary);
+  margin: 0;
+}
+.band-copy {
+  font-size: var(--text-body);
+  line-height: 1.5;
+  color: var(--ink-secondary);
+  margin: var(--space-1) 0 0;
+  max-width: 560px;
+}
+.band-mono {
+  font-family: var(--font-mono);
+  font-size: var(--text-caption);
+  color: var(--ink-muted);
+  letter-spacing: 0.02em;
+}
+.band-pulse {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--mid-blue);
+  animation: koano-pulse 1.6s ease-in-out infinite;
+  flex: none;
+}
+.band-agents {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: var(--space-2);
+  flex: 0 1 560px;
+}
+.band-agent {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding: var(--space-2);
+  border: 1px solid var(--border-light);
+  border-radius: var(--radius-chip);
+  min-width: 0;
+}
+.band-agent-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--border);
+}
+.band-agent-running .band-agent-dot {
+  background: var(--mid-blue);
+  animation: koano-pulse 1.6s ease-in-out infinite;
+}
+.band-agent-complete .band-agent-dot {
+  background: var(--signal-positive);
+}
+.band-agent-name {
+  font-size: var(--text-caption);
+  color: var(--ink-secondary);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.band-agent-verdict {
+  font-family: var(--font-mono);
+  font-size: var(--text-micro);
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+.band-main {
+  flex: 1 1 320px;
+  min-width: 0;
+}
+.band-word {
+  font-size: var(--text-verdict);
+  font-weight: 700;
+  letter-spacing: -0.02em;
+  line-height: 1;
+  text-transform: uppercase;
+}
+.band-address {
+  font-size: var(--text-ui);
+  color: var(--ink-secondary);
+  margin: var(--space-2) 0 0;
+}
+.band-headline {
+  font-size: var(--text-lead);
+  line-height: 1.5;
+  color: var(--ink-primary);
+  margin: var(--space-2) 0 0;
+  max-width: 640px;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.band-metrics {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(96px, 1fr));
+  gap: var(--space-4);
+  margin: 0;
+  flex: 0 1 360px;
+}
+.band-metrics dt {
+  font-family: var(--font-mono);
+  font-size: var(--text-micro);
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--ink-muted);
+}
+.band-metrics dd {
+  font-family: var(--font-mono);
+  font-size: var(--text-data-l);
+  font-weight: 500;
+  color: var(--ink-primary);
+  margin: var(--space-1) 0 0;
+  white-space: nowrap;
+}
+.band-unit {
+  font-size: var(--text-data);
+  color: var(--ink-muted);
+  margin-left: 4px;
+}
+.band-meter {
+  display: block;
+  height: 4px;
+  border-radius: 2px;
+  background: var(--border-light);
+  overflow: hidden;
+  margin-top: var(--space-2);
+}
+.band-meter span {
+  display: block;
+  height: 100%;
+}
+.band-foot {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: var(--space-4);
+  flex-wrap: wrap;
+  border-top: 1px solid var(--border-light);
+  padding-top: var(--space-4);
+}
+.band-summary {
+  margin: 0;
+}
+.band-actions {
+  display: flex;
+  gap: var(--space-2);
+  flex-wrap: wrap;
+}
+.band-btn {
+  padding: 9px 16px;
+  min-height: 40px;
+}
+@media (max-width: 767px) {
+  .verdict-band {
+    padding: var(--space-4);
+    max-height: none;
+  }
+  .band-agents {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    flex-basis: 100%;
+  }
+  .band-metrics {
+    flex-basis: 100%;
+  }
+  .band-word {
+    font-size: 40px;
+  }
+  .band-btn {
+    min-height: 44px;
+    flex: 1 1 calc(50% - var(--space-2));
+  }
+}
+
+/* Evidence drawer --------------------------------------------------------- */
+.drawer-backdrop {
+  position: fixed;
+  inset: 0;
+  z-index: 40;
+  background: rgba(13, 43, 62, 0.28);
+}
+.evidence-drawer {
+  position: fixed;
+  z-index: 41;
+  top: var(--nav-h);
+  right: 0;
+  bottom: 0;
+  width: min(600px, 100vw);
+  background: var(--white);
+  border-left: 1px solid var(--border);
+  box-shadow: var(--shadow-hover);
+  display: flex;
+  flex-direction: column;
+}
+.drawer-head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: var(--space-3);
+  padding: var(--space-5) var(--space-5) var(--space-3);
+}
+.drawer-address {
+  font-size: var(--text-ui);
+  font-weight: 500;
+  color: var(--ink-primary);
+  margin: 0;
+}
+.drawer-tabs {
+  display: flex;
+  gap: var(--space-1);
+  padding: 0 var(--space-5);
+  border-bottom: 1px solid var(--border);
+}
+.drawer-tab {
+  min-height: 44px;
+  padding: 0 var(--space-3);
+  border: 0;
+  border-bottom: 2px solid transparent;
+  background: transparent;
+  color: var(--ink-muted);
+  font: inherit;
+  font-size: var(--text-body);
+  cursor: pointer;
+  margin-bottom: -1px;
+}
+.drawer-tab[aria-selected="true"] {
+  color: var(--ink-primary);
+  font-weight: 500;
+  border-bottom-color: var(--deep-navy);
+}
+.drawer-body {
+  flex: 1 1 auto;
+  overflow-y: auto;
+  padding: var(--space-5);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+}
+@media (max-width: 767px) {
+  .evidence-drawer {
+    top: 0;
+    width: 100vw;
+    border-left: 0;
+  }
+  .drawer-head,
+  .drawer-body {
+    padding-left: var(--space-4);
+    padding-right: var(--space-4);
+  }
+  .drawer-tabs {
+    padding: 0 var(--space-4);
+    overflow-x: auto;
+  }
+}
+
+/* Global search ---------------------------------------------------------- */
+.gsearch {
+  position: relative;
+  width: 100%;
+}
+.gsearch-bar {
+  max-width: 560px;
+}
+.gsearch-field {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  min-height: 44px;
+  padding: 0 var(--space-2) 0 var(--space-4);
+  border: 1px solid var(--border-input);
+  border-radius: var(--radius-pill);
+  background: var(--white);
+  color: var(--ink-muted);
+}
+.gsearch-field:focus-within {
+  border-color: var(--deep-navy);
+}
+.gsearch-input {
+  flex: 1 1 auto;
+  min-width: 0;
+  border: 0;
+  background: transparent;
+  font: inherit;
+  font-size: var(--text-ui);
+  color: var(--ink-primary);
+  min-height: 42px;
+}
+.gsearch-input::placeholder {
+  color: var(--ink-muted);
+}
+.gsearch-input:focus-visible {
+  outline: 2px solid var(--deep-navy);
+  outline-offset: -2px;
+  border-radius: var(--radius-pill);
+}
+.gsearch-kbd {
+  font-family: var(--font-mono);
+  font-size: var(--text-micro);
+  letter-spacing: 0.04em;
+  color: var(--ink-muted);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-chip);
+  padding: 2px 6px;
+  background: var(--pale-wash);
+}
+.gsearch-go {
+  padding: 9px 18px;
+  min-height: 40px;
+}
+.gsearch-panel-bar {
+  position: absolute;
+  top: calc(100% + var(--space-2));
+  left: 0;
+  right: 0;
+  z-index: 35;
+  background: var(--white);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-card);
+  box-shadow: var(--shadow-hover);
+  padding: var(--space-2);
+  max-height: 60vh;
+  overflow-y: auto;
+}
+.gsearch-panel-sheet {
+  margin-top: var(--space-3);
+}
+.gsearch-group {
+  display: flex;
+  flex-direction: column;
+}
+.gsearch-heading {
+  font-family: var(--font-mono);
+  font-size: var(--text-micro);
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--ink-muted);
+  padding: var(--space-2) var(--space-3);
+}
+.gsearch-row {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  width: 100%;
+  min-height: 44px;
+  padding: var(--space-2) var(--space-3);
+  border: 0;
+  border-radius: var(--radius-chip);
+  background: transparent;
+  text-align: left;
+  font: inherit;
+  color: var(--ink-primary);
+}
+.gsearch-option {
+  cursor: pointer;
+}
+.gsearch-option:hover {
+  background: var(--pale-wash);
+}
+.gsearch-quiet {
+  flex-direction: row;
+  align-items: center;
+  gap: var(--space-2);
+  color: var(--ink-secondary);
+  font-size: var(--text-body);
+}
+.gsearch-row-main {
+  font-size: var(--text-body);
+}
+.gsearch-row-meta {
+  font-family: var(--font-mono);
+  font-size: var(--text-micro);
+  letter-spacing: 0.06em;
+  color: var(--ink-muted);
+}
