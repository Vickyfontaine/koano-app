+  bottom: var(--space-6);
+  z-index: 2;
+  display: inline-flex;
+  background: var(--white);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-pill);
+  overflow: hidden;
+  box-shadow: var(--shadow-flat);
+}
+.map-frame-controls button {
+  min-height: 36px;
+  padding: 0 var(--space-3);
+  border: 0;
+  background: transparent;
+  color: var(--ink-muted);
+  font: inherit;
+  font-size: var(--text-caption);
+  cursor: pointer;
+}
+.map-frame-controls button[aria-pressed="true"] {
+  background: var(--pale-wash);
+  color: var(--ink-primary);
+  font-weight: 500;
+}
+.this-week-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-3);
+}
+.this-week-tile {
+  border: 1px solid var(--border-light);
+  border-radius: var(--radius-inner);
+  padding: var(--space-4);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-1);
+  min-width: 0;
+}
+.this-week-value {
+  font-family: var(--font-mono);
+  font-size: var(--text-data-l);
+  font-weight: 500;
+  color: var(--ink-primary);
+  line-height: 1.1;
+}
+@media (max-width: 767px) {
+  .this-week-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+/* Comp cards: the sale price is the widest figure */
+.comp-card .card-figures {
+  grid-template-columns: 1.5fr 1fr 1fr;
+}
+.comp-card .card-figures dd {
+  font-size: var(--text-ui);
+}
+/* The owner / renter switch sits inline on wide screens, full width on phones. */
+@media (min-width: 768px) {
+  .segmented {
+    align-self: flex-start;
+  }
+}
+@media (max-width: 767px) {
+  .segmented button {
+    flex: 1 1 0;
+  }
+  /* History closes every lens on phones. */
+  #c1-history,
+  #c2-history,
+  #c4-history,
+  #c5-history {
+    order: 6;
+  }
+}
