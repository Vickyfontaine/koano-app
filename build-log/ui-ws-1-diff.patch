+const BANNED_LANGUAGE: RegExp[] = [
+  /\bgentrif\w*/i,
+  /\b(high|low)[- ]wealth\b/i,
+  /\baffluen\w*/i,
+  /\bwealthy\b/i,
+  /\bupscale\b/i,
