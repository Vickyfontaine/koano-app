+  /\b(ethnic|racial)\w*/i,
+  /\bimmigrant\w*/i,
+  /\bworking[- ]class\b/i,
+  /\bupper[- ]middle[- ]class\b/i,
+];
+
+export function bannedLanguage(text: string): string[] {
+  const hits: string[] = [];
+  for (const re of BANNED_LANGUAGE) {
+    const m = text.match(re);
+    if (m) hits.push(m[0]);
+  }
+  return Array.from(new Set(hits));
