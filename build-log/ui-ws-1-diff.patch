+const WHITE_LABEL = new Set(['cma', 'client_neighborhood_report', 'pricing_recommendation_sheet', 'buyer_seller_net_sheet']);
+const out = process.argv[2] ?? 'build-log/docs';
+mkdirSync(out, { recursive: true });
+(async () => {
