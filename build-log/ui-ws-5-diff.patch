diff --git a/src/components/ui/trace/TraceProvider.tsx b/src/components/ui/trace/TraceProvider.tsx
new file mode 100644
index 0000000..1f8e3e6
--- /dev/null
+++ b/src/components/ui/trace/TraceProvider.tsx
@@ -0,0 +1,100 @@
+"use client";
+
+// Trace (UI sprint WS5): pull any figure like a thread. Trace mode is toggled
+// by the band's Trace button or the T key; in Trace mode, hovering or focusing
+// any element that carries data-trace="<node>" shows that node's thread and
+// highlights every node on it, dimming the rest to 35%. The graph is built
+// from the complete payload only (see graph.ts).
+
+import React, { createContext, useCallback, useContext, useEffect, useMemo, useState } from "react";
+import type { SynthesisResult } from "../verdict";
+import { buildThread, threadIds, type TraceNodeId, type TraceSegment } from "./graph";
+
+interface TraceContextValue {
+  on: boolean;
+  toggle: () => void;
+  setOn: (v: boolean) => void;
+  focus: TraceNodeId | null;
+  setFocus: (id: TraceNodeId | null) => void;
+  /** The run the thread is built from (set by the shell once a result exists). */
+  setResult: (r: SynthesisResult | null) => void;
+  thread: TraceSegment[];
+}
+
+const TraceContext = createContext<TraceContextValue>({
+  on: false,
+  toggle: () => {},
+  setOn: () => {},
+  focus: null,
+  setFocus: () => {},
+  setResult: () => {},
+  thread: [],
+});
+
+export function useTrace(): TraceContextValue {
+  return useContext(TraceContext);
+}
+
+function isTypingTarget(el: EventTarget | null): boolean {
+  const t = el as HTMLElement | null;
+  if (!t) return false;
+  const tag = t.tagName;
+  return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || t.isContentEditable;
+}
+
+export default function TraceProvider({ children }: { children: React.ReactNode }) {
+  const [on, setOn] = useState(false);
+  const [focus, setFocus] = useState<TraceNodeId | null>(null);
+  const [result, setResult] = useState<SynthesisResult | null>(null);
+  const toggle = useCallback(() => setOn((v) => !v), []);
+
+  // T toggles Trace mode (never while typing).
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key.toLowerCase() === "t" && !e.metaKey && !e.ctrlKey && !e.altKey && !isTypingTarget(e.target)) {
+        e.preventDefault();
+        setOn((v) => !v);
+      }
+      if (e.key === "Escape") setFocus(null);
+    };
+    document.addEventListener("keydown", onKey);
+    return () => document.removeEventListener("keydown", onKey);
+  }, []);
+
+  // One listener for every data-trace element: hover or focus sets the thread.
+  useEffect(() => {
+    if (!on) {
+      setFocus(null);
+      document.body.classList.remove("trace-on");
+      return;
+    }
+    document.body.classList.add("trace-on");
+    const pick = (e: Event) => {
+      const el = (e.target as HTMLElement | null)?.closest?.("[data-trace]") as HTMLElement | null;
+      if (el) setFocus(el.getAttribute("data-trace") as TraceNodeId);
+    };
+    document.addEventListener("mouseover", pick);
+    document.addEventListener("focusin", pick);
+    return () => {
+      document.removeEventListener("mouseover", pick);
+      document.removeEventListener("focusin", pick);
+      document.body.classList.remove("trace-on");
+    };
+  }, [on]);
+
+  const thread = useMemo(() => (on && focus && result ? buildThread(result, focus) : []), [on, focus, result]);
+
+  // Highlight the nodes on the thread; dim the rest (CSS does the dimming).
+  useEffect(() => {
+    const ids = threadIds(thread);
+    const all = Array.from(document.querySelectorAll<HTMLElement>("[data-trace]"));
+    for (const el of all) el.classList.toggle("trace-hit", ids.has(el.getAttribute("data-trace") ?? ""));
+    document.body.classList.toggle("trace-focused", ids.size > 0);
+    return () => {
+      document.body.classList.remove("trace-focused");
+    };
+  }, [thread]);
+
+  const value = useMemo(() => ({ on, toggle, setOn, focus, setFocus, setResult, thread }), [on, toggle, focus, thread]);
+  return <TraceContext.Provider value={value}>{children}</TraceContext.Provider>;
+}
diff --git a/src/components/ui/trace/TraceThread.tsx b/src/components/ui/trace/TraceThread.tsx
new file mode 100644
index 0000000..159dd7c
--- /dev/null
+++ b/src/components/ui/trace/TraceThread.tsx
@@ -0,0 +1,40 @@
+"use client";
+
+// TraceThread: the thread as a labeled list, top (the figure) to bottom (its
+// sources), each segment's line styled by provenance: solid live, dotted
+// partner, hatched representative, dashed fetch_failed, cut coverage_absent.
+
+import React from "react";
+import { PROVENANCE_META } from "../verdict";
+import { useTrace } from "./TraceProvider";
+
+export default function TraceThread() {
+  const { on, thread, focus } = useTrace();
+  if (!on) return null;
+  return (
+    <div className="trace-thread" aria-live="polite" aria-atomic="true">
+      {thread.length === 0 ? (
+        <p className="trace-hint">
+          Trace is on. Hover or focus the verdict, a figure, a vote or a source row to follow its thread. Press T to leave.
+        </p>
+      ) : (
+        <ol className="trace-list" aria-label={`Thread for ${focus}`}>
+          {thread.map((s, i) => (
+            <li key={`${s.id}-${i}`} className={`trace-seg trace-seg-${s.provenance ?? "none"}`}>
+              <span className="trace-line" aria-hidden="true" />
+              <span className="trace-seg-body">
+                <span className="trace-seg-label">{s.label}</span>
+                {s.op && <span className="trace-seg-op">{s.op}</span>}
+                {s.provenance && s.provenance !== "live" && (
+                  <span className="trace-seg-prov" style={{ color: PROVENANCE_META[s.provenance].color }}>
+                    {PROVENANCE_META[s.provenance].label}: {PROVENANCE_META[s.provenance].note}
+                  </span>
+                )}
+              </span>
+            </li>
+          ))}
+        </ol>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/ui/trace/graph.ts b/src/components/ui/trace/graph.ts
new file mode 100644
index 0000000..d966e8d
--- /dev/null
+++ b/src/components/ui/trace/graph.ts
@@ -0,0 +1,99 @@
+// Trace graph (UI sprint WS5): the dependency thread behind any figure, built
+// only from the `complete` payload (the breakdown, the agent summaries, the
+// data points). Nothing here is estimated; a node that is not in the payload
+// is not on the thread.
+
+import type { Provenance, SynthesisResult } from "../verdict";
+import { AGENT_LABELS } from "../verdict";
+
+export type TraceNodeId = "verdict" | "score" | `agent:${string}` | `point:${string}`;
+
+export interface TraceSegment {
+  id: TraceNodeId;
+  /** What this node is. */
+  label: string;
+  /** The operation that links it to the node above (e.g. "× conf 82 ÷ Σ 391"). */
+  op?: string;
+  provenance?: Provenance;
+  /** Partner name, unlock source or feed, when the provenance calls for one. */
+  note?: string;
+}
+
+const fmt = (n: number, d = 2) => `${n >= 0 ? "+" : ""}${n.toFixed(d)}`;
+
+export function pointId(agent: string, label: string): TraceNodeId {
+  return `point:${agent}:${label}`;
+}
+
+/** The thread for a node: from the figure down to its sources, top first. */
+export function buildThread(result: SynthesisResult, node: TraceNodeId): TraceSegment[] {
+  const wb = result.weighting_breakdown;
+  const points = result.data_points ?? [];
+  const head: TraceSegment = { id: "verdict", label: `Verdict ${result.verdict.toUpperCase()}`, provenance: result.overall_provenance };
+  if (!wb) return [head, { id: "score", label: "The verdict math was not stored for this run", op: "no breakdown" }];
+
+  const final = wb.final_score ?? wb.aggregate_score;
+  const score: TraceSegment = {
+    id: "score",
+    label: `Final score ${fmt(final)}`,
+    op:
+      wb.structural_nudge && wb.structural_nudge !== 0
+        ? `agent score ${fmt(wb.aggregate_score)} + nudge ${fmt(wb.structural_nudge)} from: ${(wb.structural_drivers ?? []).join("; ")}`
+        : `agent score ${fmt(wb.aggregate_score)} against thresholds buy ≥ ${wb.thresholds.buy}, hold ≥ ${wb.thresholds.hold}, wait ≥ ${wb.thresholds.wait}`,
+  };
+  const agentSeg = (agent: string): TraceSegment | null => {
+    const a = wb.agents.find((x) => x.agent === agent);
+    if (!a) return null;
+    const share = wb.total_weight ? a.contribution / wb.total_weight : 0;
+    const prov = result.agent_summaries.find((s) => s.agent === agent)?.overall_provenance;
+    return {
+      id: `agent:${agent}`,
+      label: `${AGENT_LABELS[agent as keyof typeof AGENT_LABELS] ?? agent}: ${a.verdict} at confidence ${a.confidence}`,
+      op: a.direction === 0 ? "neutral vote, no weight" : `direction ${a.direction} × conf ${a.confidence} ÷ Σ ${wb.total_weight} = ${fmt(share)}`,
+      provenance: prov,
+    };
+  };
+  const pointSegs = (agent: string, max: number): TraceSegment[] =>
+    points
+      .filter((p) => p.agent === agent)
+      .slice(0, max)
+      .map((p) => ({
+        id: pointId(agent, p.label),
+        label: `${p.label} = ${String(p.value ?? "n/a")}`,
+        op: p.source,
+        provenance: p.provenance,
+      }));
+
+  if (node === "verdict" || node === "score") {
+    const movers = wb.agents.filter((a) => a.direction !== 0);
+    const out: TraceSegment[] = [head, score];
+    for (const m of movers) {
+      const s = agentSeg(m.agent);
+      if (s) out.push(s, ...pointSegs(m.agent, 3));
+    }
+    if (movers.length === 0) out.push({ id: "agent:none", label: "No agent returned a directional vote", op: "every vote was hold" });
+    return out;
+  }
+  if (node.startsWith("agent:")) {
+    const agent = node.slice(6);
+    const s = agentSeg(agent);
+    return s ? [head, score, s, ...pointSegs(agent, 8)] : [head, score];
+  }
+  if (node.startsWith("point:")) {
+    const rest = node.slice(6);
+    const agent = rest.slice(0, rest.indexOf(":"));
+    const label = rest.slice(rest.indexOf(":") + 1);
+    const p = points.find((x) => x.agent === agent && x.label === label);
+    const s = agentSeg(agent);
+    const seg: TraceSegment = p
+      ? { id: node, label: `${p.label} = ${String(p.value ?? "n/a")}`, op: p.source, provenance: p.provenance }
+      : { id: node, label, op: "not in this run's evidence" };
+    // Reverse trace: from the figure up to what it moved.
+    return s ? [seg, { ...s, op: `this figure fed the ${AGENT_LABELS[agent as keyof typeof AGENT_LABELS] ?? agent} read; ${s.op}` }, score, head] : [seg, score, head];
+  }
+  return [head];
+}
+
+export function threadIds(segments: TraceSegment[]): Set<string> {
+  return new Set(segments.map((s) => s.id));
+}
